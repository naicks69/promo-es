# Copie para .env (uso local) ou cadastre no Render em Environment.

# Obrigatórias: credenciais da API de Afiliados da Shopee
# (affiliate.shopee.com.br > Open API)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Banco permanente (Postgres gratuito do Neon: neon.tech > Connection string).
# Sem ela, usa sistema.db, que é apagado a cada deploy no Render.
DATABASE_URL=

# WhatsApp
# Senha combinada entre o site e o bot (invente uma senha forte e use a mesma
# no arquivo bot/.env). Sem ela, o bot não consegue falar com o site.
WHATSAPP_BOT_TOKEN=
# Número do bot com DDI e DDD (padrão: 5511910032144)
# WHATSAPP_NUMERO_BOT=5511910032144
# Link do grupo: não precisa preencher, o bot envia sozinho ao usar !ativar.
# Só use para forçar outro link.
# WHATSAPP_LINK=

# Opcionais (valores padrão entre parênteses)
# INTERVALO_VARREDURA=300        (busca ofertas novas a cada 5 minutos)
# HORAS_VALIDADE_OFERTA=4        (cada oferta fica no site por até 4 horas)
# INTERVALO_WHATSAPP=600         (envia ofertas no WhatsApp a cada 10 minutos)
# OFERTAS_POR_MENSAGEM=3         (quantas ofertas vão em cada rodada)
# SILENCIO_INICIO=22             (não envia no WhatsApp das 22h...)
# SILENCIO_FIM=8                 (...às 8h, horário de Brasília)
# PRODUTOS_POR_BUSCA=6
# PAGINAS_ROTACAO=10

# RENDER_EXTERNAL_URL é preenchida pelo próprio Render e liga o "manter acordado".
