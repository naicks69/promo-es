# Copie para .env (uso local) ou cadastre no Render em Environment.

# Obrigatórias: credenciais da API de Afiliados da Shopee
# (affiliate.shopee.com.br > Open API)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Banco permanente (Postgres gratuito do Neon: neon.tech > Connection string).
# Sem ela, usa sistema.db, que é apagado a cada deploy no Render.
DATABASE_URL=

# Link de convite do grupo de WhatsApp mostrado no site (botão some se vazio)
WHATSAPP_LINK=

# Endereço público do bot de WhatsApp
WHATSAPP_BOT_URL=

# Opcionais
# INTERVALO_VARREDURA=300
# MAX_ENVIOS_POR_CICLO=3
# PRODUTOS_POR_BUSCA=6

# RENDER_EXTERNAL_URL é preenchida pelo próprio Render e liga o "manter acordado".
