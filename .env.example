# Copie para .env (uso local) ou cadastre no Render em Environment.

# Obrigatórias: credenciais da API de Afiliados da Shopee
# (affiliate.shopee.com.br > Open API)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Banco permanente (Postgres gratuito do Neon: neon.tech > Connection string).
# Sem ela, usa sistema.db, que é apagado a cada deploy no Render.
DATABASE_URL=

# WhatsApp
# Senha combinada entre o site e o bot (invente uma senha forte e use a mesma
# no arquivo bot/.env). Sem ela, o bot não consegue falar com o site.
WHATSAPP_BOT_TOKEN=
# Número do bot com DDI e DDD (padrão: 5511910032144)
# WHATSAPP_NUMERO_BOT=5511910032144
# Link do grupo: não precisa preencher, o bot envia sozinho ao usar !ativar.
# Só use para forçar outro link.
# WHATSAPP_LINK=

# Mercado Livre (aplicativo criado em developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Identificação de afiliado (do link do Gerador de links). Já vêm preenchidas:
# ML_AFILIADO_USUARIO=sana8907971
# ML_AFILIADO_FERRAMENTA=95146766
# ML_DESCONTO_MINIMO=0           (desconto mínimo em %; 0 = todos, os com desconto aparecem primeiro)
# ML_PRECO_MINIMO=75             (Mercado Livre só com produtos a partir deste preço)
# ML_COMISSAO_ESTIMADA=5         (comissão média estimada, só para comparar com a Shopee)

# AliExpress (portals.aliexpress.com + aplicativo na Open Platform)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Amazon: tag de afiliado usada no link de busca (padrão: vidinhaoferta-20)
# AMAZON_TAG=vidinhaoferta-20

# Opcionais (valores padrão entre parênteses)
# INTERVALO_VARREDURA=300        (busca ofertas novas a cada 5 minutos)
# HORAS_VALIDADE_OFERTA=4        (cada oferta fica no site por até 4 horas)
# INTERVALO_WHATSAPP=600         (envia ofertas no WhatsApp a cada 10 minutos)
# OFERTAS_POR_MENSAGEM=3         (quantas ofertas vão em cada rodada)
# SILENCIO_INICIO=22             (não envia no WhatsApp das 22h...)
# SILENCIO_FIM=8                 (...às 8h, horário de Brasília)
# PRODUTOS_POR_BUSCA=6           (quantos produtos ficam de cada busca)
# CANDIDATOS_POR_BUSCA=20        (quantos a Shopee analisa antes de escolher os que mais rendem)
# COMISSAO_MINIMA=0              (comissão mínima em % na Shopee)
# VENDAS_MINIMAS=10              (vendas mínimas na Shopee)
# SHOPEE_PRECO_MAXIMO=100        (Shopee só com produtos até este preço nas varreduras)
# PAGINAS_ROTACAO=10

# RENDER_EXTERNAL_URL é preenchida pelo próprio Render e liga o "manter acordado".
